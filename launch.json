{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: gdb 调试",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/main",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [
                { "name": "GTK_PATH", "value": "" },
                { "name": "GIO_MODULE_DIR", "value": "" },
                { "name": "LD_LIBRARY_PATH", "value": "/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "cmake-build",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}